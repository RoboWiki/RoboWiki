{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://github.com/RoboWiki/RoboWiki.github.io/schema/robot.schema.json",
 "title": "整机机器人（data/robots/<厂商>.json 中的一条）",
 "description": "ADR-005 P1。公共字段约束 $ref 自 base.schema.json；现有数据用 category（而非 kind）标注实体类型、且无 license/sources 字段，故不 allOf 继承 base 的整体 required，先按现有数据放宽，迁移到命名空间 id + kind 后再对齐。",
 "type": "object",
 "required": [
  "id",
  "category",
  "subtype",
  "vendor",
  "model",
  "title",
  "url",
  "source_tier",
  "verified",
  "last_checked",
  "origin",
  "specs"
 ],
 "additionalProperties": true,
 "properties": {
  "id": {
   "$ref": "base.schema.json#/properties/id"
  },
  "title": {
   "$ref": "base.schema.json#/properties/title"
  },
  "source_tier": {
   "$ref": "base.schema.json#/properties/source_tier"
  },
  "verified": {
   "$ref": "base.schema.json#/properties/verified"
  },
  "last_checked": {
   "$ref": "base.schema.json#/properties/last_checked"
  },
  "origin": {
   "$ref": "base.schema.json#/properties/origin"
  },
  "url": {
   "$ref": "base.schema.json#/properties/url"
  },
  "sources": {
   "$ref": "base.schema.json#/properties/sources"
  },
  "license": {
   "$ref": "base.schema.json#/properties/license"
  },
  "notes": {
   "$ref": "base.schema.json#/properties/notes"
  },
  "category": {
   "const": "robot",
   "description": "实体大类。现有数据用 category 而非 base 的 kind，迁移后统一为 kind。"
  },
  "subtype": {
   "type": "string",
   "description": "构型细分，如 humanoid / quadruped / wheeled_quadruped / biped。受控词表见 data/taxonomy.json。"
  },
  "subtype_label": {
   "type": "string",
   "description": "subtype 的中文展示名。"
  },
  "vendor": {
   "type": "string",
   "minLength": 1
  },
  "vendor_cn": {
   "type": [
    "string",
    "null"
   ],
   "description": "厂商中文名。"
  },
  "model": {
   "type": "string",
   "minLength": 1
  },
  "price_cny": {
   "type": [
    "integer",
    "null"
   ],
   "description": "人民币参考价；未公开为 null，不要在 notes 里塞别代产品的价格冒充。"
  },
  "specs": {
   "type": "object",
   "additionalProperties": true,
   "properties": {
    "dof": {
     "type": [
      "integer",
      "null"
     ],
     "description": "自由度。按官方 URDF/参数表口径，未公布留 null。"
    },
    "mass_kg": {
     "type": [
      "number",
      "null"
     ]
    },
    "payload_kg": {
     "type": [
      "number",
      "null"
     ]
    },
    "speed_max_mps": {
     "type": [
      "number",
      "null"
     ]
    },
    "size_mm": {
     "type": [
      "string",
      "null"
     ]
    },
    "climb_height_mm": {
     "type": [
      "number",
      "null"
     ]
    },
    "climb_angle_deg": {
     "type": [
      "number",
      "null"
     ]
    },
    "battery": {
     "type": [
      "string",
      "null"
     ]
    },
    "endurance_h": {
     "type": [
      "number",
      "string",
      "null"
     ],
     "description": "续航。存在「空载/负载」两个口径时用字符串描述。"
    },
    "voltage_V": {
     "type": [
      "number",
      "null"
     ]
    },
    "voltage_range_V": {
     "type": [
      "string",
      "null"
     ]
    },
    "iface": {
     "type": [
      "string",
      "null"
     ],
     "description": "对外接口。"
    },
    "compute": {
     "type": [
      "string",
      "null"
     ],
     "description": "机载算力。"
    },
    "sensors": {
     "type": [
      "string",
      "null"
     ]
    },
    "image_url": {
     "type": [
      "string",
      "null"
     ]
    },
    "image_source": {
     "type": [
      "string",
      "null"
     ]
    },
    "doc_url": {
     "type": [
      "string",
      "null"
     ]
    },
    "doc_pdf": {
     "type": [
      "string",
      "null"
     ]
    },
    "repo_urls": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "官方/社区代码仓库。没有则为空数组。"
    },
    "urdf_urls": {
     "type": [
      "array",
      "null"
     ],
     "items": {
      "type": "string"
     },
     "description": "URDF/模型描述文件链接。"
    },
    "ecosystem_id": {
     "type": "string",
     "description": "关联 data/robot_ecosystem.json 的生态条目 id。"
    }
   }
  },
  "openness": {
   "type": "string",
   "enum": [
    "full",
    "partial"
   ],
   "description": "整机开源程度。full = 官方公开到可复现整机的程度（至少机械设计/CAD 与硬件资料在公开仓库里，BOM 缺失需在 notes 说明）；partial = 只开放代码、SDK、URDF 或仿真资产，机械与硬件不公开。"
  },
  "openness_note": {
   "type": [
    "string",
    "null"
   ],
   "description": "开源程度的边界说明：例如官方只开源软件、BOM 来自社区复刻，或 BOM/CAD 仍在进行中。有保留就写，别只写“全开源”三个字。"
  },
  "bom": {
   "type": [
    "array",
    "null"
   ],
   "description": "方案包的物料清单。一条 = 型号 + 数量；能对上部件库就填 part_id，对不上留 null。没整理就整段写 null，不要编。",
   "items": {
    "type": "object",
    "required": [
     "name",
     "qty"
    ],
    "additionalProperties": true,
    "properties": {
     "part_id": {
      "type": [
       "string",
       "null"
      ],
      "description": "部件库 id；未收录为 null"
     },
     "name": {
      "type": "string",
      "description": "型号或物料名，必须能买到或能查"
     },
     "qty": {
      "type": "number",
      "minimum": 0,
      "description": "数量"
     },
     "note": {
      "type": [
       "string",
       "null"
      ],
      "description": "替代料、来源或注意项"
     }
    }
   }
  },
  "steps": {
   "type": [
    "array",
    "null"
   ],
   "description": "复现步骤。按时间线排，每步一个可验收的判据；没有判据的步骤等于没有。",
   "items": {
    "type": "object",
    "required": [
     "title"
    ],
    "additionalProperties": true,
    "properties": {
     "order": {
      "type": [
       "integer",
       "null"
      ],
      "description": "顺序号，从 1 开始，可缺省（缺省按数组顺序）"
     },
     "title": {
      "type": "string"
     },
     "detail": {
      "type": [
       "string",
       "null"
      ]
     },
     "criteria": {
      "type": [
       "string",
       "null"
      ],
      "description": "完成判据：看到什么才算这一步过了"
     },
     "pitfall": {
      "type": [
       "string",
       "null"
      ],
      "description": "这一步最常踩的坑"
     }
    }
   }
  },
  "artifacts_origin": {
   "type": [
    "object",
    "null"
   ],
   "description": "artifacts 每项的来源：official（官方仓库/官方文档）或 community（社区复刻、反推整理）。缺省视为 official；社区 BOM/CAD 必须标 community。",
   "additionalProperties": {
    "type": "string",
    "enum": [
     "official",
     "community"
    ]
   }
  },
  "artifacts": {
   "type": [
    "object",
    "null"
   ],
   "description": "交付物链接。缺哪一项就写 null，不要用仓库地址顶替 CAD。",
   "additionalProperties": false,
   "properties": {
    "urdf": {
     "type": [
      "string",
      "null"
     ],
     "description": "urdf 的下载或浏览地址"
    },
    "cad": {
     "type": [
      "string",
      "null"
     ],
     "description": "cad 的下载或浏览地址"
    },
    "hardware": {
     "type": [
      "string",
      "null"
     ],
     "description": "硬件/PCB 工程文件（原理图、板卡、Gerber）的浏览地址；没有就写 null"
    },
    "bom": {
     "type": [
      "string",
      "null"
     ],
     "description": "bom 的下载或浏览地址"
    },
    "firmware": {
     "type": [
      "string",
      "null"
     ],
     "description": "firmware 的下载或浏览地址"
    },
    "assembly": {
     "type": [
      "string",
      "null"
     ],
     "description": "assembly 的下载或浏览地址"
    },
    "docs": {
     "type": [
      "string",
      "null"
     ],
     "description": "docs 的下载或浏览地址"
    }
   }
  }
 }
}
